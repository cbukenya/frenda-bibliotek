#!/usr/bin/env bash
# scripts/hooks/pre-push
# Source file for the pre-push hook. Install via scripts/install-hooks.sh.
# Checks that the branch being pushed has no more than one EF Core migration.

set -euo pipefail

MIGRATIONS_DIR="backend/FrendaBibliotek.Api/Data/Migrations"
CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "HEAD")

# Only enforce on feature/bug/chore branches, not main
if [ "$CURRENT_BRANCH" = "main" ]; then
  exit 0
fi

MIGRATION_COUNT=$(find "$MIGRATIONS_DIR" -maxdepth 1 -name "*_*.cs" ! -name "*.Designer.cs" 2>/dev/null | wc -l | tr -d ' ')

if [ "$MIGRATION_COUNT" -gt 1 ]; then
  echo ""
  echo "  [migration check] This branch has $MIGRATION_COUNT migrations."
  echo "  Each PR should contain exactly one migration."
  echo "  Run ./reset-migrations.sh to squash them before pushing."
  echo ""
  exit 1
fi

exit 0
